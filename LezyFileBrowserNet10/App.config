<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>

    <!-- ================================================================
         NOTE: Per-profile settings (InputDir, OkDir, Sort, InplaceBrowsing,
         MinFileSizeMb, MaxListItems, MoveWithRobocopy, NoCache, NoDupeCheck,
         ProfileLog) are now stored in the Windows registry:
           HKCU\Software\LezyFileBrowser\Profiles\<ProfileName>
         Use the Profiles menu inside the app to manage them.
         ================================================================ -->

    <!-- ================================================================
         PLAYER FOCUS
         ================================================================ -->

    <!-- How long to wait after launching before giving up on focus enforcement (milliseconds). -->
    <add key="LAUNCH_FOCUS_DELAY_MS" value="666" />

    <!-- How often to check and enforce player window focus (milliseconds). -->
    <add key="PLAYER_FOCUS_POLL_MS" value="333" />

    <!-- Comma-separated list of media player process names to focus and kill. -->
    <add key="PLAYER_PROCESS_NAMES" value="mplayer,mpc-hc64,smplayer" />

    <!-- ================================================================
         FILE OPERATION THRESHOLDS
         ================================================================ -->

    <!-- Maximum number of files allowed in a directory before deletion is blocked. -->
    <add key="MAX_FILES_IN_DIR_TO_DELETE" value="5" />

    <!-- Files smaller than this size (kilobytes) are ignored when counting files in a directory. -->
    <add key="MIN_DIR_SIZE_FOR_COUNT_KB" value="256" />

    <!-- Delay before retrying a failed file I/O operation (milliseconds). -->
    <add key="IO_RETRY_DELAY_MS" value="4000" />

    <!-- ================================================================
         MEDIA PLAYERS
         ================================================================ -->

    <!-- PLAYER_1: mplayer -->
    <add key="PLAYER_1_EXE"   value="c:\Program Files\SMPlayer\mplayer\mplayer.exe" />
    <add key="PLAYER_1_ARGS"  value="-noautosub -nojoystick -nolirc -idx -quiet -cache 32768 -vo directx -ao dsound -framedrop -af volnorm -zoom -xy 1400 -vf scale -volume 35" />
    <add key="PLAYER_1_FS_ARG"     value="-fs" />
    <add key="PLAYER_1_ON_TOP_ARG"    value="-ontop" />
    <add key="PLAYER_1_WINDOW_STYLE"  value="Minimized" />

    <!-- PLAYER_2: MPC-HC -->
    <add key="PLAYER_2_EXE"   value="c:\Program Files (x86)\K-Lite Codec Pack\MPC-HC64\mpc-hc64.exe" />
    <add key="PLAYER_2_FS_ARG"     value="/fullscreen" />
    <add key="PLAYER_2_ON_TOP_ARG"    value="/ontop" />
    <add key="PLAYER_2_WINDOW_STYLE"  value="Normal" />

    <!-- Fullscreen outside this daytime window (HHmm). Before 07:00 or from 20:00 = fullscreen. -->
    <add key="FS_HHMM_BEFORE" value="0700" />
    <add key="FS_HHMM_AFTER"  value="2000" />

    <!-- Path length above which a %TEMP%\tmp.mp4 symlink is used (Windows MAX_PATH without long-path support). -->
    <add key="LONG_PATH_THRESHOLD" value="260" />

    <!-- ================================================================
         EXTERNAL TOOLS
         ================================================================ -->

    <!-- Path to the Total Commander executable. -->
    <add key="TC_EXE" value="C:\Program Files\totalcmd\TOTALCMD64.EXE" />

    <!-- Path to the SABnzbd SRR database lookup script. -->
    <add key="SCRIPT_SABNZBD" value="c:\bin\zscripts\A13_SABnzbd_SRRdb.cmd" />

    <!-- Suffix passed to the SABnzbd script when Shift is NOT held (F4 without Shift). -->
    <add key="REL_SUFFIX" value="PUBLISHEDBY" />

    <!-- ================================================================
         UI / POLLING INTERVALS
         ================================================================ -->

    <!-- How often the pending-delete timer ticks to update the title bar (milliseconds). -->
    <add key="PENDING_DELETE_POLL_MS" value="2000" />

    <!-- How often the background file-operation queue is checked when idle (milliseconds). -->
    <add key="FILEOP_QUEUE_POLL_MS" value="3000" />

    <!-- ================================================================
         DUPLICATE CHECK
         ================================================================ -->

    <!-- Read-buffer size for byte-by-byte file comparison during duplicate detection (bytes). -->
    <add key="DUPE_CHECK_BUFFER_SIZE" value="65536" />

    <!-- ================================================================
         HIGHLIGHT COLORS  (R,G,B format)
         ================================================================ -->

    <!-- Background color for items already present in okDir. -->
    <add key="COLOR_ALREADY_SAVED" value="220,80,80" />

    <!-- Background color for content-identical duplicate items. -->
    <add key="COLOR_DUPE" value="255,200,60" />

    <!-- Background color for similarly-named items (same show, different release). -->
    <add key="COLOR_SIMILAR_NAME" value="255,210,140" />

    <!-- Path to the web browser executable used for torrent searches. -->
    <add key="BROWSER_EXE" value="C:\Program Files\Mozilla Firefox\firefox.exe" />

    <!-- First torrent search engine URL. The search query is appended directly. -->
    <add key="BT_SEARCH_URL_1" value="https://bt4gprx.com/search?q=" />

    <!-- Second torrent search engine URL. The search query is appended directly. -->
    <add key="BT_SEARCH_URL_2" value="https://btdig.com/search?q=" />

    <!-- Comma-separated list of video file extensions that trigger media player launch. -->
    <add key="VIDEO_EXTENSIONS" value=".asf,.avi,.f4v,.flv,.m2ts,.m4v,.mov,.mp4,.mpg,.mpeg,.mpv,.mkv,.mts,.qt,.ts,.vob,.wmv" />

    <!-- ================================================================
         DUPLICATE DETECTION
         Applies only to video files larger than X_MIN_FILE_SIZE_MB.
         Files are considered duplicates when their size matches AND
         the first DUPE_CHECK_HEAD_MB and last DUPE_CHECK_TAIL_MB of
         content are byte-identical.
         ================================================================ -->

    <!-- Megabytes to compare at the start of the file for duplicate detection. -->
    <add key="DUPE_CHECK_HEAD_MB" value="10" />

    <!-- Megabytes to compare at the end of the file for duplicate detection. -->
    <add key="DUPE_CHECK_TAIL_MB" value="10" />

    <!-- Minimum number of leading dot-separated tokens that two entry names must share
         to be considered similarly named (same show, different quality/group/tag).
         E.g. "Show.26.03.02.CJ" = 5 tokens. -->
    <add key="SIMILAR_NAME_MIN_TOKENS" value="5" />

    <add key="ClientSettingsProvider.ServiceUri" value="" />
  </appSettings>
</configuration>
